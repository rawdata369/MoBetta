+    /* Mouse-look: while the client hides the cursor and holds mouse capture,
+     * its cursor warps (SetCursorPos) move only Wine's cursor position.  The
+     * Mac cursor is detached from the mouse and stays inside the capture
+     * window; mouse movement reaches Wine as relative deltas.  Windows hides
+     * the cursor in this state, so where the client warps it never shows
+     * there.  On the Mac, warping moves the real (hidden) cursor: WoW 3.3.5a
+     * warps to (origin + size) / 2 of its client area, which lies outside its
+     * window on a display left of the main one, over other apps. */
+    - (BOOL) shouldDetachForMouseLook
+    {
+        return clientWantsCursorHidden && mouseCaptureWindow && !self.clippingCursor &&
+               ![windowsBeingDragged count] && [NSApp isActive];
+    }
+
+    - (BOOL) startMouseLook
+    {
+        NSRect contentRect;
+
+        if (mouseLookDetached)
+            return TRUE;
+
+        // Freeze the cursor inside the capture window.
+        contentRect = [mouseCaptureWindow contentRectForFrameRect:[mouseCaptureWindow frame]];
+        if (!NSMouseInRect([NSEvent mouseLocation], contentRect, NO))
+        {
+            NSPoint center = NSMakePoint(NSMidX(contentRect), NSMidY(contentRect));
+            CGWarpMouseCursorPosition(NSPointToCGPoint([self flippedMouseLocation:center]));
+        }
+
+        if (CGAssociateMouseAndMouseCursorPosition(false) != kCGErrorSuccess)
+            return FALSE;
+
+        mouseLookDetached = TRUE;
+        lastSetCursorPositionTime = 0;
+        mouseMoveDeltaX = 0;
+        mouseMoveDeltaY = 0;
+        return TRUE;
+    }
+
+    - (void) stopMouseLook
+    {
+        if (!mouseLookDetached)
+            return;
+
+        CGAssociateMouseAndMouseCursorPosition(true);
+        mouseLookDetached = FALSE;
+        forceNextMouseMoveAbsolute = TRUE;
+    }
+
+    - (void) updateMouseLook
+    {
+        if (mouseLookDetached && ![self shouldDetachForMouseLook])
+            [self stopMouseLook];
+    }
+
+    - (void) setMouseCaptureWindow:(WineWindow*)window
+    {
+        if (window != mouseCaptureWindow)
+        {
+            [mouseCaptureWindow release];
+            mouseCaptureWindow = [window retain];
+        }
+        [self updateMouseLook];
+    }
+
     - (void) setCursor:(NSCursor*)newCursor
     {
         if (newCursor != cursor)
