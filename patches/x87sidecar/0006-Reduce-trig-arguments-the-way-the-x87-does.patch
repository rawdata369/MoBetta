index 0000000..c109d84
--- /dev/null
+++ b/tests/test_trig_large.c
@@ -0,0 +1,165 @@
+/*
+ * test_trig_large.c — fsin / fcos / fsincos / fptan for |x| >= 2^23 (MoBetta).
+ *
+ * The x87 reduces trig arguments exactly by its 66-bit π
+ * (0xC90FDAA22168C234C·2^-66) for |x| < 2^63; at and beyond 2^63 fsin and
+ * fcos leave ST(0) unchanged and set C2.  Native Rosetta reproduces both.
+ * The inline polynomials once reduced with a 3-step Cody-Waite that falls
+ * apart past 2^23 (fsin(1e18) = 4e20) and ignored the 2^63 rule.
+ *
+ * Expected values: exact reduction by the 66-bit π in rationals, then
+ * libm on the reduced argument (generated offline, MoBetta Session #36).
+ * Tolerance: 8 ULP or 2^-52 absolute (results near zero).
+ */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static int failures = 0;
+
+static uint64_t bits(double d) {
+    uint64_t u;
+    memcpy(&u, &d, sizeof(u));
+    return u;
+}
+static double dbl(uint64_t u) {
+    double d;
+    memcpy(&d, &u, sizeof(d));
+    return d;
+}
+
+static void check_close(const char* op, double x, double got, uint64_t want_bits) {
+    const double want = dbl(want_bits);
+    const uint64_t g = bits(got);
+    uint64_t ulp = (g > want_bits) ? g - want_bits : want_bits - g;
+    if ((g >> 63) != (want_bits >> 63)) {
+        ulp = (g & ~(1ULL << 63)) + (want_bits & ~(1ULL << 63));
+    }
+    const int ok = ulp <= 8 || fabs(got - want) <= 0x1p-52;
+    printf("%s  %-8s x=%-24.17g got=0x%016llx want=0x%016llx ulp=%llu\n", ok ? "PASS" : "FAIL",
+           op, x, (unsigned long long)g, (unsigned long long)want_bits, (unsigned long long)ulp);
+    if (!ok) {
+        failures++;
+    }
+}
+
+static void check_bits(const char* name, uint64_t got, uint64_t want) {
+    const int ok = got == want;
+    printf("%s  %-40s got=0x%016llx want=0x%016llx\n", ok ? "PASS" : "FAIL", name,
+           (unsigned long long)got, (unsigned long long)want);
+    if (!ok) {
+        failures++;
+    }
+}
+
+static void check_c2(const char* name, uint16_t sw, int want) {
+    const int c2 = (sw >> 10) & 1;
+    printf("%s  %-40s sw=0x%04x C2=%d (want %d)\n", c2 == want ? "PASS" : "FAIL", name,
+           (unsigned)sw, c2, want);
+    if (c2 != want) {
+        failures++;
+    }
+}
+
+/* fxam first sets C2 = 1 for a normal value, so a stale C2 shows. */
+#define UNARY(NAME, INSN)                                                              \
+    static double NAME(double v, uint16_t* sw) {                                       \
+        double r;                                                                      \
+        uint16_t s;                                                                    \
+        __asm__ volatile("fldl %2\n\tfxam\n\t" INSN "\n\tfnstsw %%ax\n\tmovw %%ax, %1\n\t" \
+                         "fstpl %0\n\t"                                                \
+                         : "=m"(r), "=m"(s)                                            \
+                         : "m"(v)                                                      \
+                         : "ax", "st");                                                \
+        *sw = s;                                                                       \
+        return r;                                                                      \
+    }
+UNARY(do_fsin, "fsin")
+UNARY(do_fcos, "fcos")
+
+static void do_fsincos(double v, double* s, double* c) {
+    __asm__ volatile("fldl %2\n\tfsincos\n\tfstpl %1\n\tfstpl %0\n\t"
+                     : "=m"(*s), "=m"(*c)
+                     : "m"(v)
+                     : "st", "st(1)");
+}
+
+static double do_fptan(double v) {
+    double t, one;
+    __asm__ volatile("fldl %2\n\tfptan\n\tfstpl %1\n\tfstpl %0\n\t"
+                     : "=m"(t), "=m"(one)
+                     : "m"(v)
+                     : "st", "st(1)");
+    return t;
+}
+
+/* A run of several trig ops in one block (the IR path lowers them). */
+static double do_sin_plus_cos(double a, double b) {
+    double r;
+    __asm__ volatile("fldl %1\n\tfsin\n\tfldl %2\n\tfcos\n\tfaddp\n\tfstpl %0\n\t"
+                     : "=m"(r)
+                     : "m"(a), "m"(b)
+                     : "st", "st(1)");
+    return r;
+}
+
+static const struct {
+    double x;
+    uint64_t sin, cos, tan;
+} kCases[] = {
+    {0x1p23, 0x3fdba9f45d1ca715ULL, 0xbfecdb2c9e19e3aaULL, 0xbfdead86dfe19adaULL},
+    {1e7 + 0.25, 0x3fc76ced5e991ca5ULL, 0xbfef75a4a57e703cULL, 0xbfc7d3f36e86998bULL},
+    {-123456789.5, 0xbfedf4f404fe0e02ULL, 0xbfd68090105c4db5ULL, 0x40054cf1f0db8ff8ULL},
+    {1e10, 0xbfdf334c78938de6ULL, 0x3febf098901d6fedULL, 0xbfe1de000f41ed21ULL},
+    {-3.75e12, 0x3fe4025ad0e882ceULL, 0xbfe8f8fdef1adf1bULL, 0xbfe9a3cd301632f9ULL},
+    {1e15, 0x3feb76f71e81bc08ULL, 0xbfe06c1797415982ULL, 0xbffac230e07a4812ULL},
+    {1e18, 0xbfefc526473b316cULL, 0x3fbea1662c6379f5ULL, 0xc0209865c30750a2ULL},
+    {-4.5e18, 0x3fcf21aaf53e4370ULL, 0x3fef0a039658fa4aULL, 0x3fd00c3169f336d2ULL},
+    {0x1.fffffffffffffp+62, 0x3fef984e05a54f44ULL, 0xbfc44d36e751af24ULL, 0xc018e68298f11e21ULL},
+};
+
+int main(void) {
+    uint16_t sw;
+    char name[64];
+    for (unsigned i = 0; i < sizeof kCases / sizeof kCases[0]; i++) {
+        const double x = kCases[i].x;
+        check_close("fsin", x, do_fsin(x, &sw), kCases[i].sin);
+        check_c2("fsin in range clears C2", sw, 0);
+        check_close("fcos", x, do_fcos(x, &sw), kCases[i].cos);
+        check_c2("fcos in range clears C2", sw, 0);
+        double s, c;
+        do_fsincos(x, &s, &c);
+        check_close("fsincos.s", x, s, kCases[i].sin);
+        check_close("fsincos.c", x, c, kCases[i].cos);
+        check_close("fptan", x, do_fptan(x), kCases[i].tan);
+    }
+    check_close("sin+cos", 1e15, do_sin_plus_cos(1e15, 1e15),
+                bits(dbl(kCases[5].sin) + dbl(kCases[5].cos)));
+
+    /* |x| >= 2^63: fsin / fcos leave ST(0) unchanged and set C2. */
+    const double big[] = {0x1p63, -1e22, 1e308};
+    for (unsigned i = 0; i < 3; i++) {
+        snprintf(name, sizeof name, "fsin %g unchanged", big[i]);
+        check_bits(name, bits(do_fsin(big[i], &sw)), bits(big[i]));
+        check_c2("fsin out of range sets C2", sw, 1);
+        snprintf(name, sizeof name, "fcos %g unchanged", big[i]);
+        check_bits(name, bits(do_fcos(big[i], &sw)), bits(big[i]));
+        check_c2("fcos out of range sets C2", sw, 1);
+    }
+
+    /* Inf: invalid, the default NaN, C2 = 0.  NaN: quieted, C2 = 0. */
+    check_bits("fsin inf", bits(do_fsin(INFINITY, &sw)), 0xfff8000000000000ULL);
+    check_c2("fsin inf C2", sw, 0);
+    check_bits("fcos -inf", bits(do_fcos(-INFINITY, &sw)), 0xfff8000000000000ULL);
+    check_c2("fcos -inf C2", sw, 0);
+    check_bits("fsin qnan", bits(do_fsin(dbl(0x7ff8000000000001ULL), &sw)), 0x7ff8000000000001ULL);
+    check_bits("fcos qnan", bits(do_fcos(dbl(0xfff8000000000123ULL), &sw)), 0xfff8000000000123ULL);
+
+    if (failures) {
+        printf("FAILED: %d\n", failures);
+        return 1;
+    }
+    printf("ALL PASS\n");
+    return 0;
+}
