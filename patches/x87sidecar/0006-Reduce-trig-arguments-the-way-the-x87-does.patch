+// ── Large arguments (MoBetta) ────────────────────────────────────────
+// The 3-step Cody-Waite reduction above is good for |x| < 2^23 only.
+// Real x87 (and stock Rosetta) reduce exactly up to 2^63 and leave ST(0)
+// unchanged with C2 = 1 beyond.  A flag-free guard sends |x| >= 2^23,
+// Inf and NaN to an out-of-line path: an exact Payne-Hanek reduction
+// for |x| < 2^63 (64-bit fixed-point fraction of x/π), else the x87
+// out-of-range result.  The fast path gains four instructions.
+
+// A64 encodings the helper set lacks (checked against clang).
+constexpr uint32_t kA64Umulh = 0x9BC07C00U;   // UMULH Xd, Xn, Xm
+constexpr uint32_t kA64Mul = 0x9B007C00U;     // MUL   Xd, Xn, Xm
+constexpr uint32_t kA64Adds = 0xAB000000U;    // ADDS  Xd, Xn, Xm
+constexpr uint32_t kA64Adc = 0x9A000000U;     // ADC   Xd, Xn, Xm
+constexpr uint32_t kA64Lsrv = 0x9AC02400U;    // LSRV  Xd, Xn, Xm
+constexpr uint32_t kA64And = 0x8A000000U;     // AND   Xd, Xn, Xm
+constexpr uint32_t kA64Add = 0x8B000000U;     // ADD   Xd, Xn, Xm
+constexpr uint32_t kA64AddLsl3 = 0x8B000C00U;   // ADD Xd, Xn, Xm, LSL #3
+constexpr uint32_t kA64AddLsr63 = 0x8B40FC00U;  // ADD Xd, Xn, Xm, LSR #63
+constexpr uint32_t kA64EorLsr63 = 0xCA40FC00U;  // EOR Xd, Xn, Xm, LSR #63
+constexpr uint32_t kA64Eor = 0xCA000000U;     // EOR   Xd, Xn, Xm
+constexpr uint32_t kA64Sub = 0xCB000000U;     // SUB   Xd, Xn, Xm
+
+void a64_rrr(AssemblerBuffer& buf, uint32_t op, int Rd, int Rn, int Rm) {
+    buf.emit(op | (static_cast<uint32_t>(Rm & 31) << 16) | (static_cast<uint32_t>(Rn & 31) << 5) |
+             static_cast<uint32_t>(Rd & 31));
+}
+void a64_sub_imm(AssemblerBuffer& buf, int Rd, int Rn, uint32_t imm12) {  // SUB Xd, Xn, #imm
+    buf.emit(0xD1000000U | ((imm12 & 0xFFFU) << 10) | (static_cast<uint32_t>(Rn & 31) << 5) |
+             static_cast<uint32_t>(Rd & 31));
+}
+void a64_ubfm(AssemblerBuffer& buf, int Rd, int Rn, uint32_t immr, uint32_t imms) {
+    buf.emit(0xD3400000U | ((immr & 63U) << 16) | ((imms & 63U) << 10) |
+             (static_cast<uint32_t>(Rn & 31) << 5) | static_cast<uint32_t>(Rd & 31));
+}
+void a64_lsr(AssemblerBuffer& buf, int Rd, int Rn, uint32_t s) { a64_ubfm(buf, Rd, Rn, s, 63); }
+void a64_lsl(AssemblerBuffer& buf, int Rd, int Rn, uint32_t s) {
+    a64_ubfm(buf, Rd, Rn, (64 - s) & 63U, 63 - s);
+}
+void a64_asr63(AssemblerBuffer& buf, int Rd, int Rn) {  // ASR Xd, Xn, #63
+    buf.emit(0x937FFC00U | (static_cast<uint32_t>(Rn & 31) << 5) | static_cast<uint32_t>(Rd & 31));
+}
+void a64_logical_imm64(AssemblerBuffer& buf, int opc, int Rd, int Rn, uint64_t imm) {
+    LogicalImmEncoding enc{};
+    const bool ok = is_bitmask_immediate(/*is_64bit=*/true, imm, enc);
+    assert(ok && "not a bitmask immediate");
+    (void)ok;
+    emit_logical_imm(buf, /*is_64bit=*/1, opc, enc.N, static_cast<int8_t>(enc.immr),
+                     static_cast<int8_t>(enc.imms), Rn, Rd);
+}
+constexpr int kLogAnd = 0, kLogOrr = 1, kLogEor = 2;
+
+// Forward-branch fixups: point the branch emitted at `at` to buf.end.
+void patch_imm14_here(AssemblerBuffer& buf, uint64_t at) {
+    buf.data[at / 4] |= static_cast<uint32_t>(((buf.end - at) / 4) & 0x3FFFU) << 5;
+}
+void patch_imm19_here(AssemblerBuffer& buf, uint64_t at) {
+    buf.data[at / 4] |= static_cast<uint32_t>(((buf.end - at) / 4) & 0x7FFFFU) << 5;
+}
+void patch_imm26_here(AssemblerBuffer& buf, uint64_t at) {
+    buf.data[at / 4] |= static_cast<uint32_t>((buf.end - at) / 4) & 0x3FFFFFFU;
+}
+
+// Xg := biased exponent of Dx - 1046 (no flags).  Returns the offset of a
+// TBZ taken when Xg >= 0, i.e. |x| >= 2^23, Inf or NaN.
+uint64_t emit_large_arg_guard(AssemblerBuffer& buf, int Dx, int Xg) {
+    emit_fmov_d_to_x(buf, Xg, Dx);
+    a64_ubfm(buf, Xg, Xg, 52, 62);  // UBFX Xg, Xg, #52, #11
+    a64_sub_imm(buf, Xg, Xg, rosetta_core::kPayneHanekMinExp);
+    const uint64_t at = buf.end;
+    emit_tbz(buf, /*TBZ*/ 0, Xg, 63, 0);
+    return at;
+}
+
+enum class PhMode : std::uint8_t { Sin, Cos, Tan };
+
+// Exact reduction for 2^23 <= |x| < 2^63.  Entry: Xg = biased exp - 1046
+// (>= 0).  Returns the offset of a TBZ to the out-of-range path (|x| >=
+// 2^63, Inf, NaN), taken with Xg intact.  Fall-through result:
+//   Sin/Cos: Dr = x - n·π (|Dr| <= π/2), n as emit_trig_range_reduce
+//            picks it; Xq bit 0 = n's parity (Sin: XOR the sign of x)
+//   Tan:     Dr = (x - q·π/2)/2, Xq bit 0 = q's parity
+// The fraction carries 64 bits, so |error| <= ~2^-63 absolute.  Guest
+// NZCV is parked in Dpark around the ADDS/ADC; Xconst is used as a
+// scratch and rematerialised.  Clobbers Xg, Dpark, Dtmp.
+uint64_t emit_payne_hanek(AssemblerBuffer& buf, int Dx, int Xconst, int Xq, int Xg, int Dr,
+                          int Dpark, int Dtmp, PhMode mode) {
+    const uint64_t consts_addr = rosetta_core::get_transcendental_constants_addr();
+    a64_sub_imm(buf, Xq, Xg, rosetta_core::kPayneHanekEntries);
+    const uint64_t huge = buf.end;
+    emit_tbz(buf, /*TBZ*/ 0, Xq, 63, 0);  // index >= 40: |x| >= 2^63, Inf, NaN
+
+    emit_mrs_nzcv(buf, Xq);
+    emit_fmov_x_to_d(buf, Dpark, Xq);
+
+    a64_rrr(buf, kA64AddLsl3, Xconst, Xconst, Xg);                      // &consts + 8·i
+    emit_ldr_str_imm(buf, 3, /*is_fp=*/0, /*LDR*/ 1, ConstOff::PhMid, Xconst, Xq);      // mid
+    emit_ldr_str_imm(buf, 3, /*is_fp=*/0, /*LDR*/ 1, ConstOff::PhLo, Xconst, Xconst);  // lo
+    emit_fmov_x_to_d(buf, Dtmp, Xg);  // park i
+    emit_fmov_d_to_x(buf, Xg, Dx);
+    a64_logical_imm64(buf, kLogAnd, Xg, Xg, 0x000FFFFFFFFFFFFFULL);
+    a64_logical_imm64(buf, kLogOrr, Xg, Xg, 0x0010000000000000ULL);  // M
+    a64_rrr(buf, kA64Umulh, Xconst, Xg, Xconst);  // hi(M·lo)
+    emit_fmov_x_to_d(buf, Dr, Xconst);
+    a64_rrr(buf, kA64Mul, Xconst, Xg, Xq);    // lo(M·mid)
+    a64_rrr(buf, kA64Umulh, Xq, Xg, Xq);      // hi(M·mid)
+    emit_fmov_d_to_x(buf, Xg, Dr);
+    a64_rrr(buf, kA64Adds, Xconst, Xconst, Xg);  // f = bits 64..127
+    a64_rrr(buf, kA64Adc, Xq, Xq, GPR::XZR);     // bit 0 -> bit 128
+    emit_fmov_x_to_d(buf, Dr, Xconst);
+    emit_movz_movk_abs64(buf, Xconst, consts_addr);
+    emit_ldr_str_imm(buf, 3, /*is_fp=*/0, /*LDR*/ 1, ConstOff::PhHi, Xconst, Xconst);
+    emit_fmov_d_to_x(buf, Xg, Dtmp);
+    a64_rrr(buf, kA64Lsrv, Xconst, Xconst, Xg);  // bit 0 = bit 128 of T_i
+    emit_fmov_d_to_x(buf, Xg, Dx);               // bit 0 = M's bit 0
+    a64_rrr(buf, kA64And, Xconst, Xconst, Xg);
+    a64_rrr(buf, kA64Add, Xq, Xq, Xconst);  // bit 0 = parity of floor(|x|/π)
+    emit_fmov_d_to_x(buf, Xconst, Dr);      // f
+    if (mode == PhMode::Cos) {
+        // |x|/π + 1/2: the carry out of f flips the parity.
+        a64_rrr(buf, kA64AddLsr63, Xq, Xq, Xconst);
+        a64_logical_imm64(buf, kLogEor, Xconst, Xconst, 0x8000000000000000ULL);
+    } else if (mode == PhMode::Tan) {
+        // 2|x|/π: the parity is f's top bit, the fraction f << 1.
+        a64_lsr(buf, Xq, Xconst, 63);
+        a64_lsl(buf, Xconst, Xconst, 1);
+    }
+    // Round to nearest: a fraction >= 1/2 bumps n and reads as f - 1 signed.
+    a64_rrr(buf, kA64AddLsr63, Xq, Xq, Xconst);
+    if (mode == PhMode::Sin) {
+        emit_fmov_d_to_x(buf, Xg, Dx);
+        a64_rrr(buf, kA64EorLsr63, Xq, Xq, Xg);  // sin(-x) = -sin(x)
+    } else if (mode == PhMode::Tan) {
+        emit_fmov_d_to_x(buf, Xg, Dx);  // tan(-x) = -tan(x): negate the fraction
+        a64_asr63(buf, Xg, Xg);
+        a64_rrr(buf, kA64Eor, Xconst, Xconst, Xg);
+        a64_rrr(buf, kA64Sub, Xconst, Xconst, Xg);
+    }
+    emit_scvtf_x_to_d(buf, Dr, Xconst);
+    emit_movz_movk_abs64(buf, Xconst, consts_addr);
+    emit_fldr_imm(buf, 3, Dtmp, Xconst,
+                  mode == PhMode::Tan ? ConstOff::PhPi2m66 : ConstOff::PhPi2m64);
+    emit_fmul_f64(buf, Dr, Dr, Dtmp);
+
+    emit_fmov_d_to_x(buf, Xg, Dpark);
+    emit_msr_nzcv(buf, Xg);
+    return huge;
+}
+
+// Out-of-range result into Dres; entry Xg = biased exp - 1046 (>= 40).
+// Finite: `keep` → ST(0) unchanged and C2 = 1 (fsin/fcos), else the
+// default NaN (fsincos/fptan, whose x87 form would also skip the push).
+// Inf: the default NaN.  NaN: quieted.  Every exit is a B to patch.
+void emit_trig_out_of_range(AssemblerBuffer& buf, int Dx, int Xq, int Xg, int Dres, int Xbase,
+                            bool keep, uint64_t exits[3]) {
+    a64_sub_imm(buf, Xq, Xg, 2047 - rosetta_core::kPayneHanekMinExp);
+    const uint64_t special = buf.end;
+    emit_cbz(buf, /*is_64bit=*/1, /*CBZ*/ 0, Xq, 0);
+    if (keep) {
+        static constexpr int16_t kSwImm12 = kX87StatusWordOff / 2;
+        LogicalImmEncoding c2{};
+        is_bitmask_immediate(/*is_64bit=*/false, 0x400U, c2);
+        emit_ldr_str_imm(buf, /*size=*/1, /*is_fp=*/0, /*LDRH*/ 1, kSwImm12, Xbase, Xq);
+        emit_logical_imm(buf, /*is_64bit=*/0, kLogOrr, c2.N, static_cast<int8_t>(c2.immr),
+                         static_cast<int8_t>(c2.imms), Xq, Xq);
+        emit_ldr_str_imm(buf, /*size=*/1, /*is_fp=*/0, /*STRH*/ 0, kSwImm12, Xbase, Xq);
