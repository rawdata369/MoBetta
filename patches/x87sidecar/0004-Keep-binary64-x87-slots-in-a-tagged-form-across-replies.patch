+/*
+ * x87_tagged.h: the tagged binary64 of x87sidecar's X87_TAGGED_SLOTS.
+ *
+ * With X87_TAGGED_SLOTS (default on with X87_NATIVE_SLOTS), a register the
+ * sidecar holds in binary64 is left in its 80-bit slot as bytes 0-7 = the
+ * binary64 bits with the sign cleared, bytes 8-9 = sign << 15 | 0x7FFF: a
+ * pseudo-infinity or pseudo-NaN, which the x87 never produces.  Everything
+ * that moves the slot as bytes (fxch, the signal context, fxsave, the thread
+ * state) keeps it, and everything that reads it as a value decodes it.  Code
+ * that inspects saved x87 registers as data, as the tests including this
+ * header do, sees the tagged form; x87_untag gives the 80-bit value it
+ * stands for.  An 80-bit load from guest memory of a value in the tagged
+ * range gives the indefinite (x87_tagged_range).
+ */
+#ifndef X87_TAGGED_H
+#define X87_TAGGED_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+static inline int x87_tagged_range(uint64_t mant, uint16_t se) {
+    return (se & 0x7FFF) == 0x7FFF && (mant >> 63) == 0;
+}
+
+/* Whether the sidecar under test may tag slots: X87_TAGGED_SLOTS and
+ * X87_NATIVE_SLOTS, both default on, neither set to 0.  Natively nothing is
+ * tagged, and the values the tests use there never fall in the range. */
+static inline int x87_tags_possible(void) {
+    const char* t = getenv("X87_TAGGED_SLOTS");
+    const char* n = getenv("X87_NATIVE_SLOTS");
+    return !(t != NULL && strcmp(t, "0") == 0) && !(n != NULL && strcmp(n, "0") == 0);
+}
+
+/* The 80-bit value a tagged binary64 stands for; anything else unchanged. */
+static inline void x87_untag(uint64_t* mant, uint16_t* se) {
+    if (!x87_tagged_range(*mant, *se)) {
+        return;
+    }
+    const uint64_t b = *mant | ((uint64_t)(*se >> 15) << 63);
+    const uint16_t sign = (uint16_t)((b >> 48) & 0x8000);
+    const unsigned e = (unsigned)(b >> 52) & 0x7FF;
+    const uint64_t f = (b << 12) >> 1; /* fraction at bits 62..11 */
+    if (e == 0) {
+        if (f == 0) {
+            *mant = 0;
+            *se = sign;
+        } else {
+            const int lz = __builtin_clzll(f);
+            *mant = f << lz;
+            *se = (uint16_t)(sign | (15361 - lz));
+        }
+    } else if (e == 0x7FF) {
+        *mant = f | (UINT64_C(1) << 63);
+        *se = (uint16_t)(sign | 0x7FFF);
+    } else {
+        *mant = f | (UINT64_C(1) << 63);
+        *se = (uint16_t)(sign | (e + 15360));
+    }
+}
+
+static inline void x87_untag_bytes(uint8_t* p) {
+    uint64_t mant;
+    uint16_t se;
+    memcpy(&mant, p, 8);
+    memcpy(&se, p + 8, 2);
+    x87_untag(&mant, &se);
+    memcpy(p, &mant, 8);
+    memcpy(p + 8, &se, 2);
+}
+
+#endif
