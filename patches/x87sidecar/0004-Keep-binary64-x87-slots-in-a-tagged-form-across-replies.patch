+// X87_TAGGED_SLOTS: stock reads a tagged slot as the default NaN.  The x87
+// state is complete in memory at every request boundary, so before the
+// first request of a stretch that stock translates, the sidecar answers
+// with a reply of its own that converts every tagged slot back to 80 bits
+// and consumes no instruction: Some(insn_idx).  Stock asks for the same
+// instruction again, gets None and translates it.  That reply has its own
+// instruction-map entry at the instruction, so a signal in it resumes at
+// stock's code for the same instruction, with the state complete.  The
+// stretch lasts until the sidecar emits code again; stock code in it reads
+// and writes 80-bit values only.  A stretch is a block's code from one
+// instruction on, entered only from its start (stock moves to another
+// block, or starts this one over, before anything else can run first).
+static bool stock_reads_slots(uint16_t op) {
+    return is_x87_opcode(op) && op != kOpcodeName_fclex && op != kOpcodeName_finit &&
+           op != kOpcodeName_fldenv && op != kOpcodeName_fxrstor;
+}
+
+namespace {
+struct StockEntry {
+    TranslationResult* tr;
+    const IRBlock* block;
+    int64_t insn_idx;
+
+    // The re-ask after the untag reply: stock translates the instruction.
+    bool is_reask() const {
+        auto& c = tr->x87_cache;
+        const bool hit = c.untag_pending_block == block && c.untag_pending_idx == insn_idx &&
+                         c.untag_pending_end == tr->insn_buf.end;
+        c.untag_pending_block = nullptr;
+        if (hit) {
+            c.untag_done_block = block;
+            c.untag_done_idx = static_cast<int32_t>(insn_idx);
+        }
+        return hit;
+    }
+
+    // None goes to stock: the untag reply first, unless this request is
+    // inside a stretch already entered.
+    std::optional<int64_t> before_stock(uint16_t op) const {
+        auto& c = tr->x87_cache;
+        if (!TranslatorX87::tagged_slots_enabled() || !stock_reads_slots(op) ||
+            (c.untag_done_block == block && insn_idx > c.untag_done_idx)) {
+            return std::nullopt;
+        }
+        const auto saved_end = tr->insn_buf.end;
+        if (!TranslatorX87::emit_untag_all_slots(*tr)) {
+            tr->insn_buf.end = saved_end;
+            static int short_count = 0;
+            if (++short_count <= 10) {
+                std::fprintf(stdout,
+                             "[rosettax87] no four free GPRs to untag the x87 slots before "
+                             "stock at insn_idx=%lld; stock may read a tagged slot (#%d)\n",
+                             static_cast<long long>(insn_idx), short_count);
+                std::fflush(stdout);
+            }
+            return std::nullopt;
+        }
+        c.untag_pending_block = block;
+        c.untag_pending_idx = static_cast<int32_t>(insn_idx);
+        c.untag_pending_end = tr->insn_buf.end;
+        c.last_next_idx = -1;
+        return insn_idx;
+    }
+};
+}  // namespace
+
+auto Translator::translate_instruction(TranslationResult* translation_result, IRBlock* block,
+                                       IRInstr* instr_array, int64_t num_instrs, int64_t insn_idx)
+    -> std::optional<int64_t> {
+    const StockEntry entry{.tr = translation_result, .block = block, .insn_idx = insn_idx};
+    if (entry.is_reask()) {
+        translation_result->x87_cache.last_next_idx = -1;
+        return std::nullopt;
+    }
+    auto ret = translate_request(translation_result, block, instr_array, num_instrs, insn_idx);
+    if (ret.has_value()) {
+        if (*ret > insn_idx) {
+            translation_result->x87_cache.untag_done_block = nullptr;
+        }
+        return ret;
+    }
+    return entry.before_stock(instr_array[insn_idx].opcode());
+}
+
+auto Translator::stock_request(TranslationResult* translation_result, IRBlock* block,
+                               IRInstr* instr_array, int64_t num_instrs, int64_t insn_idx)
+    -> std::optional<int64_t> {
+    (void)num_instrs;
+    auto& cache = translation_result->x87_cache;
+    // As for any None reply that skips the translator: stock's code clobbers
+    // the registers a cached run would trust.
+    cache.invalidate();
+    cache.prev_block = nullptr;
+    const StockEntry entry{.tr = translation_result, .block = block, .insn_idx = insn_idx};
+    if (entry.is_reask()) {
+        cache.last_next_idx = -1;
+        return std::nullopt;
+    }
+    return entry.before_stock(instr_array[insn_idx].opcode());
+}
