diff --git a/tests/test_bridge_fallthrough.c b/tests/test_bridge_fallthrough.c
new file mode 100644
index 0000000..c3d82bc
--- /dev/null
+++ b/tests/test_bridge_fallthrough.c
@@ -0,0 +1,125 @@
+/*
+ * test_bridge_fallthrough.c — Run bridging v2 across a block whose
+ * flag_liveness bytes are all zero (MoBetta 0003).
+ *
+ * Every case is an x87 region with a `sub` in its gap that ends by falling
+ * through into a loop header (a branch target, so Rosetta starts a new
+ * block there) — Wow.exe 3.3.5a 0x7f9480's shape.  Whether the sub's flags
+ * are live is decided entirely by the successor block, so these cases test
+ * that Rosetta's liveness byte follows a fall-through exit:
+ *
+ *   live  — the successor reads the sub's CF/ZF (jc, sbb, mov;jz, a whole
+ *           x87 block then jc, inc;jc).  The sub must NOT be bridged: a
+ *           setter before the region leaves the flag in the opposite state,
+ *           so a bridged (non-flag-setting) sub gives a wrong result.
+ *   dead  — the successor's first flag op is a full writer (test, mov;test).
+ *           The block is all-zero; with X87_BRIDGE_ZERO_FL (default on) the
+ *           region is v2-bridged (X87_LOG_BRIDGE), and values stay exact.
+ *
+ * The 0xfe seeding at exits the analysis cannot follow (indirect jmp,
+ * call, ret, length cut, page boundary) was measured with standalone
+ * probes (MoBetta Session #31, rdsync/captures/s31/).
+ *
+ * Build: clang -arch x86_64 -O0 -o test_bridge_fallthrough test_bridge_fallthrough.c
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static int failures = 0;
+
+static void check_u32(const char* name, uint32_t got, uint32_t expected) {
+    if (got != expected) {
+        printf("FAIL  %-55s  got=0x%08x  expected=0x%08x\n", name, got, expected);
+        failures++;
+    } else {
+        printf("PASS  %s\n", name);
+    }
+}
+
+static void check(const char* name, double got, double expected) {
+    uint64_t g, e;
+    memcpy(&g, &got, 8);
+    memcpy(&e, &expected, 8);
+    if (g != e) {
+        printf("FAIL  %-55s  got=%.17g  expected=%.17g\n", name, got, expected);
+        failures++;
+    } else {
+        printf("PASS  %s\n", name);
+    }
+}
+
+static const double bx[4] = {2.0, 3.0, 5.0, 7.0};
+static double out;
+
+/* pre: leaves the flag the successor reads opposite to the sub's result.
+ * Region: fld/fmul | sub | fld/fmul/faddp/fstp (x87 on both sides of the
+ * gap so the bridge has something to join).  Label 1 is the successor;
+ * the never-taken back-edge makes it a block start. */
+#define CASE(name, pre, succ)                                                \
+    static uint32_t name(uint32_t a, uint32_t b) {                           \
+        uint32_t c = 0, n = 1;                                               \
+        __asm__ volatile(pre "\n\t"                                          \
+                         "fldl (%[p])\n\tfmull 8(%[p])\n\t"                  \
+                         "subl %[b], %[a]\n\t"                               \
+                         "fldl 16(%[p])\n\tfmull 24(%[p])\n\t"               \
+                         "faddp\n\tfstpl %[o]\n\t"                           \
+                         "1:\n\t" succ "\n\t"                                \
+                         "2:\n\tdecl %[n]\n\tjnz 1b\n\t"                     \
+                         : [a] "+&r"(a), [c] "+&r"(c), [n] "+&r"(n),          \
+                           [o] "=m"(out)                                     \
+                         : [b] "r"(b), [p] "r"(bx)                           \
+                         : "cc", "memory");                                  \
+        return a ^ c;                                                        \
+    }
+
+#define CF0 "clc"
+#define CF1 "stc"
+#define ZF0 "orl %[b], %[b]" /* b != 0 in every ZF case */
+#define ZF1 "cmpl %[b], %[b]"
+
+/* live: successor reads the sub's flags */
+CASE(l1_jc_borrow, CF0, "jc 2f\n\tincl %[c]")
+CASE(l1_jc_noborrow, CF1, "jc 2f\n\tincl %[c]")
+CASE(l2_sbb_borrow, CF0, "sbbl %[c], %[c]")
+CASE(l2_sbb_noborrow, CF1, "sbbl %[c], %[c]")
+CASE(l3_movjz_zero, ZF0, "movl %[a], %[c]\n\tjz 2f\n\tincl %[c]")
+CASE(l3_movjz_nonzero, ZF1, "movl %[a], %[c]\n\tjz 2f\n\tincl %[c]")
+CASE(l4_x87jc_borrow, CF0, "fldl (%[p])\n\tfstpl %[o]\n\tjc 2f\n\tincl %[c]")
+CASE(l4_x87jc_noborrow, CF1, "fldl (%[p])\n\tfstpl %[o]\n\tjc 2f\n\tincl %[c]")
+CASE(l5_incjc_borrow, CF0, "incl %[c]\n\tjc 2f\n\tincl %[c]")
+CASE(l5_incjc_noborrow, CF1, "incl %[c]\n\tjc 2f\n\tincl %[c]")
+/* dead: successor's first flag op writes every flag it later reads */
+CASE(d1_test_nonzero, CF1, "testl %[a], %[a]\n\tjz 2f\n\tincl %[c]")
+CASE(d1_test_zero, ZF0, "testl %[a], %[a]\n\tjz 2f\n\tincl %[c]")
+CASE(d2_movtest_nonzero, ZF1, "movl %[a], %[c]\n\ttestl %[c], %[c]\n\tjnz 2f\n\tincl %[c]")
+CASE(d2_movtest_zero, ZF0, "movl %[a], %[c]\n\ttestl %[c], %[c]\n\tjnz 2f\n\tincl %[c]")
+
+int main(void) {
+    printf("=== test_bridge_fallthrough ===\n");
+    /* a=1,b=2: a=0xffffffff, CF=1, ZF=0.  a=3,b=2: a=1, CF=0, ZF=0.
+     * a=b=2: a=0, CF=0, ZF=1. */
+    for (int rep = 0; rep < 3; rep++) {
+        check_u32("live jc, borrow (CF=1)", l1_jc_borrow(1, 2), 0xffffffffu);
+        check_u32("live jc, no borrow (CF=0)", l1_jc_noborrow(3, 2), 0x00000000u);
+        check_u32("live sbb, borrow", l2_sbb_borrow(1, 2), 0x00000000u);
+        check_u32("live sbb, no borrow", l2_sbb_noborrow(3, 2), 0x00000001u);
+        check_u32("live mov;jz, zero (ZF=1)", l3_movjz_zero(2, 2), 0x00000000u);
+        check_u32("live mov;jz, nonzero (ZF=0)", l3_movjz_nonzero(3, 2), 0x00000003u);
+        check_u32("live x87 block;jc, borrow", l4_x87jc_borrow(1, 2), 0xffffffffu);
+        check_u32("live x87 block;jc, no borrow", l4_x87jc_noborrow(3, 2), 0x00000000u);
+        check_u32("live inc;jc (CF through inc), borrow", l5_incjc_borrow(1, 2), 0xfffffffeu);
+        check_u32("live inc;jc (CF through inc), no borrow", l5_incjc_noborrow(3, 2), 0x00000003u);
+        check_u32("dead test, nonzero", d1_test_nonzero(1, 2), 0xfffffffeu);
+        check_u32("dead test, zero", d1_test_zero(2, 2), 0x00000000u);
+        check_u32("dead mov;test, nonzero", d2_movtest_nonzero(1, 2), 0x00000000u);
+        check_u32("dead mov;test, zero", d2_movtest_zero(2, 2), 0x00000001u);
+        check("x87 result", out, 2.0 * 3.0 + 5.0 * 7.0);
+    }
+    if (failures == 0) {
+        printf("ALL PASS  (0 failures)\n");
+    } else {
+        printf("SOME FAILURES  (%d failures)\n", failures);
+    }
+    return failures == 0 ? 0 : 1;
+}
