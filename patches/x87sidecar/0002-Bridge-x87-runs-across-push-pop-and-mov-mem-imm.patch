new file mode 100644
index 0000000..1c6f6b8
--- /dev/null
+++ b/tests/test_bridge_stack.c
@@ -0,0 +1,236 @@
+/*
+ * test_bridge_stack.c — Run bridging v1.1 (MoBetta 0002): push r / pop r and
+ * mov [m],imm joining x87 segments.
+ *
+ * Checks the FP result, the guest registers the bridges wrote, the memory
+ * they stored, and that the stack pointer comes back where it started.  The
+ * x87 ops between the push and the pop address memory through the stack
+ * pointer, so a lowering that forgot to move it, or moved it by the wrong
+ * slot size, reads the wrong value.  Meaningful under bridging (the default
+ * phases); with X87_ENABLE_BRIDGE=0 the same code checks the unbridged path.
+ *
+ * Each asm block first steps the stack pointer over the red zone, before
+ * its first x87 op, so the pushes cannot clobber the compiler's locals.
+ *
+ * Build: clang -arch x86_64 -O0 -o test_bridge_stack test_bridge_stack.c
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static int failures = 0;
+static uint64_t as_u64(double d) {
+    uint64_t u;
+    memcpy(&u, &d, 8);
+    return u;
+}
+
+static void check(const char* name, double got, double expected) {
+    if (as_u64(got) != as_u64(expected)) {
+        printf("FAIL  %-55s  got=%.17g  expected=%.17g\n", name, got, expected);
+        failures++;
+    } else {
+        printf("PASS  %s\n", name);
+    }
+}
+
+static void check_u64(const char* name, uint64_t got, uint64_t expected) {
+    if (got != expected) {
+        printf("FAIL  %-55s  got=0x%016llx  expected=0x%016llx\n", name,
+               (unsigned long long)got, (unsigned long long)expected);
+        failures++;
+    } else {
+        printf("PASS  %s\n", name);
+    }
+}
+
+int main(void) {
+    const double a[4] = {1.5, 2.5, -3.25, 4.0};
+
+    /* push r / pop r into another register across two segments. */
+    {
+        double out;
+        uint64_t moved = 0, sp_delta = 1;
+        __asm__ volatile(
+            "movq   %%rsp, %%r8\n\t"
+            "leaq   -128(%%rsp), %%rsp\n\t"
+            "movabsq $0x1122334455667788, %%rbx\n\t"
+            "fldl   (%3)\n\t"
+            "fmull  8(%3)\n\t"
+            "pushq  %%rbx\n\t" /* bridge: push r */
+            "fldl   16(%3)\n\t"
+            "fmull  24(%3)\n\t"
+            "popq   %%rsi\n\t" /* bridge: pop r */
+            "faddp\n\t"
+            "fstpl  (%4)\n\t"
+            "leaq   128(%%rsp), %%rsp\n\t"
+            "movq   %%rsi, %1\n\t"
+            "movq   %%rsp, %%r9\n\t"
+            "subq   %%r8, %%r9\n\t"
+            "movq   %%r9, %2\n\t"
+            : "=m"(out), "=m"(moved), "=m"(sp_delta)
+            : "r"(a), "r"(&out)
+            : "rbx", "rsi", "r8", "r9", "st", "st(1)", "memory");
+        check("push/pop: fp result", out, a[0] * a[1] + a[2] * a[3]);
+        check_u64("push/pop: value moved through the stack", moved, 0x1122334455667788ULL);
+        check_u64("push/pop: stack pointer restored", sp_delta, 0);
+    }
+
+    /* An x87 op reads the slot a bridged push just wrote, via the moved RSP. */
+    {
+        double out;
+        const double two = 2.0;
+        uint64_t popped = 0;
+        __asm__ volatile(
+            "leaq   -128(%%rsp), %%rsp\n\t"
+            "movq   (%2), %%rax\n\t"
+            "fldl   (%3)\n\t"
+            "fmull  8(%3)\n\t"
+            "pushq  %%rax\n\t"  /* bridge: push r */
+            "fmull  (%%rsp)\n\t" /* x87 load from the pushed slot */
+            "fldl   16(%3)\n\t"
+            "faddp\n\t"
+            "popq   %%rcx\n\t" /* bridge: pop r */
+            "fmull  24(%3)\n\t"
+            "fstpl  (%4)\n\t"
+            "leaq   128(%%rsp), %%rsp\n\t"
+            "movq   %%rcx, %1\n\t"
+            : "=m"(out), "=m"(popped)
+            : "r"(&two), "r"(a), "r"(&out)
+            : "rax", "rcx", "st", "st(1)", "memory");
+        check("push then fmul (%rsp): fp result", out, (a[0] * a[1] * 2.0 + a[2]) * a[3]);
+        check_u64("push then fmul (%rsp): popped value", popped, as_u64(2.0));
+    }
+
+    /* x87 store into the pushed slot, read back by the bridged pop. */
+    {
+        double out;
+        uint64_t popped = 0;
+        __asm__ volatile(
+            "leaq   -128(%%rsp), %%rsp\n\t"
+            "xorl   %%edx, %%edx\n\t"
+            "fldl   (%2)\n\t"
+            "fmull  8(%2)\n\t"
+            "pushq  %%rdx\n\t"   /* bridge: push r (slot = 0) */
+            "fstl   (%%rsp)\n\t" /* x87 store into it */
+            "fldl   16(%2)\n\t"
+            "faddp\n\t"
+            "popq   %%rdx\n\t" /* bridge: pop r (reads the fstl) */
+            "fmull  24(%2)\n\t"
+            "fstpl  (%3)\n\t"
+            "leaq   128(%%rsp), %%rsp\n\t"
+            "movq   %%rdx, %1\n\t"
+            : "=m"(out), "=m"(popped)
+            : "r"(a), "r"(&out)
+            : "rdx", "st", "st(1)", "memory");
+        check("fstl (%rsp) then pop: fp result", out, (a[0] * a[1] + a[2]) * a[3]);
+        check_u64("fstl (%rsp) then pop: popped bits", popped, as_u64(a[0] * a[1]));
+    }
+
+    /* Two pushes and two pops (gap of 2 each side), order preserved. */
+    {
+        double out;
+        uint64_t r1 = 0, r2 = 0;
+        __asm__ volatile(
+            "leaq   -128(%%rsp), %%rsp\n\t"
+            "movl   $0x11111111, %%ebx\n\t"
+            "movl   $0x22222222, %%esi\n\t"
+            "fldl   (%3)\n\t"
+            "fmull  8(%3)\n\t"
+            "pushq  %%rbx\n\t"
+            "pushq  %%rsi\n\t"
+            "fldl   16(%3)\n\t"
+            "fmull  24(%3)\n\t"
+            "popq   %%rbx\n\t" /* swapped on purpose */
+            "popq   %%rsi\n\t"
+            "faddp\n\t"
+            "fstpl  (%4)\n\t"
+            "leaq   128(%%rsp), %%rsp\n\t"
+            "movq   %%rbx, %1\n\t"
+            "movq   %%rsi, %2\n\t"
+            : "=m"(out), "=m"(r1), "=m"(r2)
+            : "r"(a), "r"(&out)
+            : "rbx", "rsi", "st", "st(1)", "memory");
+        check("push x2 / pop x2: fp result", out, a[0] * a[1] + a[2] * a[3]);
+        check_u64("push x2 / pop x2: rbx gets the later push", r1, 0x22222222ULL);
+        check_u64("push x2 / pop x2: rsi gets the earlier push", r2, 0x11111111ULL);
+    }
+
+    /* A popped register used as the base of the next x87 load. */
+    {
+        double out;
+        __asm__ volatile(
+            "leaq   -128(%%rsp), %%rsp\n\t"
+            "pushq  %1\n\t" /* outside the run: a's address on the stack */
+            "xorl   %%edi, %%edi\n\t"
+            "fldl   (%1)\n\t"
+            "fmull  8(%1)\n\t"
+            "popq   %%rdi\n\t" /* bridge: pop r */
+            "fldl   16(%%rdi)\n\t"
+            "fmull  24(%%rdi)\n\t"
+            "faddp\n\t"
+            "fstpl  (%2)\n\t"
+            "leaq   128(%%rsp), %%rsp\n\t"
+            : "=m"(out)
+            : "r"(a), "r"(&out)
+            : "rdi", "st", "st(1)", "memory");
+        check("pop as next base: fp result", out, a[0] * a[1] + a[2] * a[3]);
+    }
+
+    /* mov [m],imm: 32-bit, 64-bit sign-extended, zero; then fild reads it. */
+    {
+        double out;
+        uint32_t m32 = 0xdeadbeefU;
+        uint64_t m64 = 0xdeadbeefdeadbeefULL;
+        uint32_t z32 = 0xdeadbeefU;
+        uint64_t z64 = 0xdeadbeefdeadbeefULL;
+        __asm__ volatile(
+            "fldl   (%4)\n\t"
+            "fmull  8(%4)\n\t"
+            "movl   $1000, (%0)\n\t" /* bridge: mov m32,imm */
+            "movq   $-7, (%1)\n\t"   /* bridge: mov m64,imm (sign-extended) */
+            "fildl  (%0)\n\t"
+            "fildll (%1)\n\t"
+            "fmulp\n\t"
+            "faddp\n\t"
+            "movl   $0, (%2)\n\t" /* bridge: mov m32,0 */
+            "movq   $0, (%3)\n\t" /* bridge: mov m64,0 */
+            "fldl   16(%4)\n\t"
+            "faddp\n\t"
+            "fstpl  (%5)\n\t"
+            :
+            : "r"(&m32), "r"(&m64), "r"(&z32), "r"(&z64), "r"(a), "r"(&out)
+            : "st", "st(1)", "memory");
+        check("mov [m],imm: fp result", out, (a[0] * a[1] + 1000.0 * -7.0) + a[2]);
+        check_u64("mov m32,imm: stored", m32, 1000);
+        check_u64("mov m64,imm: stored sign-extended", m64, (uint64_t)-7);
+        check_u64("mov m32,0: stored", z32, 0);
+        check_u64("mov m64,0: stored", z64, 0);
+    }
+
+    /* mov m32,imm with the top bit set: no sign extension into the next word. */
+    {
+        double out;
+        uint32_t m[2] = {0, 0x5a5a5a5aU};
+        __asm__ volatile(
+            "fldl   (%1)\n\t"
+            "fmull  8(%1)\n\t"
+            "movl   $0x80000001, (%0)\n\t" /* bridge: mov m32,imm */
+            "fldl   16(%1)\n\t"
+            "faddp\n\t"
+            "fstpl  (%2)\n\t"
+            :
+            : "r"(m), "r"(a), "r"(&out)
+            : "st", "st(1)", "memory");
+        check("mov m32,imm (high bit): fp result", out, a[0] * a[1] + a[2]);
+        check_u64("mov m32,imm (high bit): stored", m[0], 0x80000001U);
+        check_u64("mov m32,imm (high bit): next word untouched", m[1], 0x5a5a5a5aU);
+    }
+
+    if (failures == 0) {
+        printf("ALL PASS  (0 failures)\n");
+    } else {
+        printf("SOME FAILURES  (%d failures)\n", failures);
+    }
+    return failures == 0 ? 0 : 1;
+}
