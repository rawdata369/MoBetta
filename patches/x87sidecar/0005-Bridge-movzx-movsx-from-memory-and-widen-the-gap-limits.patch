diff --git a/tests/test_bridge_loadext.c b/tests/test_bridge_loadext.c
new file mode 100644
index 0000000..4953a52
--- /dev/null
+++ b/tests/test_bridge_loadext.c
@@ -0,0 +1,175 @@
+/*
+ * test_bridge_loadext.c — Run bridging v1.2 (MoBetta 0005): movzx/movsx from
+ * 8- and 16-bit memory joining x87 segments, and gaps longer than four
+ * bridge instructions (X87_BRIDGE_MAX_GAP default 12, total 24).
+ *
+ * Checks the FP result and every bit of the registers the bridges wrote:
+ * the zero- or sign-extension to 32 bits, the cleared upper half of a
+ * 32-bit destination (preloaded with garbage), and the 64-bit sign
+ * extension.  One case feeds the loaded byte into the next x87 op's index
+ * register.  Meaningful under bridging (the default phases); with
+ * X87_ENABLE_BRIDGE=0 the same code checks the unbridged path.
+ *
+ * Build: clang -arch x86_64 -O0 -o test_bridge_loadext test_bridge_loadext.c
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static int failures = 0;
+static uint64_t as_u64(double d) {
+    uint64_t u;
+    memcpy(&u, &d, 8);
+    return u;
+}
+
+static void check(const char* name, double got, double expected) {
+    if (as_u64(got) != as_u64(expected)) {
+        printf("FAIL  %-55s  got=%.17g  expected=%.17g\n", name, got, expected);
+        failures++;
+    } else {
+        printf("PASS  %s\n", name);
+    }
+}
+
+static void check_u64(const char* name, uint64_t got, uint64_t expected) {
+    if (got != expected) {
+        printf("FAIL  %-55s  got=0x%016llx  expected=0x%016llx\n", name,
+               (unsigned long long)got, (unsigned long long)expected);
+        failures++;
+    } else {
+        printf("PASS  %s\n", name);
+    }
+}
+
+int main(void) {
+    const double a[4] = {1.5, 2.5, -3.25, 4.0};
+    const uint8_t b[4] = {0x80, 0x7f, 0xff, 0x02};
+    const uint16_t h[4] = {0x8000, 0x7fff, 0xffff, 0x1234};
+
+    /* 32-bit destinations, garbage in the upper halves beforehand. */
+    for (int k = 0; k < 4; k++) {
+        double out;
+        uint64_t zb = 0, sb = 0, zw = 0, sw = 0;
+        __asm__ volatile(
+            "movabsq $0xdeadbeefcafef00d, %%rax\n\t"
+            "movq   %%rax, %%rbx\n\t"
+            "movq   %%rax, %%rsi\n\t"
+            "movq   %%rax, %%rdi\n\t"
+            "fldl   (%5)\n\t"
+            "fmull  8(%5)\n\t"
+            "movzbl (%6), %%eax\n\t" /* bridge: movzx r32,m8 */
+            "movsbl (%6), %%ebx\n\t" /* bridge: movsx r32,m8 */
+            "fldl   16(%5)\n\t"
+            "fmull  24(%5)\n\t"
+            "movzwl (%7), %%esi\n\t" /* bridge: movzx r32,m16 */
+            "movswl (%7), %%edi\n\t" /* bridge: movsx r32,m16 */
+            "faddp\n\t"
+            "fstpl  (%8)\n\t"
+            "movq   %%rax, %1\n\t"
+            "movq   %%rbx, %2\n\t"
+            "movq   %%rsi, %3\n\t"
+            "movq   %%rdi, %4\n\t"
+            : "=m"(out), "=m"(zb), "=m"(sb), "=m"(zw), "=m"(sw)
+            : "r"(a), "r"(&b[k]), "r"(&h[k]), "r"(&out)
+            : "rax", "rbx", "rsi", "rdi", "st", "st(1)", "memory");
+        char name[64];
+        snprintf(name, sizeof name, "r32 [%d]: fp result", k);
+        check(name, out, a[0] * a[1] + a[2] * a[3]);
+        snprintf(name, sizeof name, "r32 [%d]: movzx m8", k);
+        check_u64(name, zb, b[k]);
+        snprintf(name, sizeof name, "r32 [%d]: movsx m8", k);
+        check_u64(name, sb, (uint32_t)(int32_t)(int8_t)b[k]);
+        snprintf(name, sizeof name, "r32 [%d]: movzx m16", k);
+        check_u64(name, zw, h[k]);
+        snprintf(name, sizeof name, "r32 [%d]: movsx m16", k);
+        check_u64(name, sw, (uint32_t)(int32_t)(int16_t)h[k]);
+    }
+
+    /* 64-bit destinations. */
+    for (int k = 0; k < 4; k++) {
+        double out;
+        uint64_t zb = 1, sb = 1, sw = 1;
+        __asm__ volatile(
+            "fldl   (%4)\n\t"
+            "fmull  8(%4)\n\t"
+            "movzbq (%5), %%rax\n\t" /* bridge: movzx r64,m8 */
+            "movsbq (%5), %%rbx\n\t" /* bridge: movsx r64,m8 */
+            "movswq (%6), %%rsi\n\t" /* bridge: movsx r64,m16 */
+            "fldl   16(%4)\n\t"
+            "fmull  24(%4)\n\t"
+            "fsubrp\n\t"
+            "fstpl  (%7)\n\t"
+            "movq   %%rax, %1\n\t"
+            "movq   %%rbx, %2\n\t"
+            "movq   %%rsi, %3\n\t"
+            : "=m"(out), "=m"(zb), "=m"(sb), "=m"(sw)
+            : "r"(a), "r"(&b[k]), "r"(&h[k]), "r"(&out)
+            : "rax", "rbx", "rsi", "st", "st(1)", "memory");
+        char name[64];
+        snprintf(name, sizeof name, "r64 [%d]: fp result", k);
+        /* AT&T fsubrp is Intel fsubp: st(1) - st(0). */
+        check(name, out, a[0] * a[1] - a[2] * a[3]);
+        snprintf(name, sizeof name, "r64 [%d]: movzx m8", k);
+        check_u64(name, zb, b[k]);
+        snprintf(name, sizeof name, "r64 [%d]: movsx m8", k);
+        check_u64(name, sb, (uint64_t)(int64_t)(int8_t)b[k]);
+        snprintf(name, sizeof name, "r64 [%d]: movsx m16", k);
+        check_u64(name, sw, (uint64_t)(int64_t)(int16_t)h[k]);
+    }
+
+    /* The loaded byte is the next x87 op's index. */
+    {
+        double out;
+        const uint8_t idx = 3;
+        __asm__ volatile(
+            "fldl   (%1)\n\t"
+            "fmull  8(%1)\n\t"
+            "movzbl (%2), %%ecx\n\t" /* bridge: movzx r32,m8 */
+            "faddl  (%1,%%rcx,8)\n\t"
+            "fmull  16(%1)\n\t"
+            "fstpl  (%3)\n\t"
+            :
+            : "m"(out), "r"(a), "r"(&idx), "r"(&out)
+            : "rcx", "st", "memory");
+        check("index from movzx m8", out, (a[0] * a[1] + a[3]) * a[2]);
+    }
+
+    /* A gap of ten bridge instructions (WoW 0x97c9a2's shape: loads from one
+     * place, stores to another), then the stores read back by x87. */
+    {
+        double out;
+        uint32_t src[3] = {0x3fc00000u, 0x40200000u, 0xc0500000u}; /* 1.5f 2.5f -3.25f */
+        uint32_t dst[3] = {0, 0, 0};
+        __asm__ volatile(
+            "fldl   (%1)\n\t"
+            "fmull  8(%1)\n\t"
+            "movl   (%2), %%edx\n\t"
+            "movl   %%edx, (%3)\n\t"
+            "movl   4(%2), %%edx\n\t"
+            "movl   %%edx, 4(%3)\n\t"
+            "movl   8(%2), %%edx\n\t"
+            "movl   %%edx, 8(%3)\n\t"
+            "movzwl 2(%2), %%eax\n\t"
+            "movsbl 11(%2), %%ecx\n\t"
+            "leal   (%%rax,%%rcx), %%eax\n\t"
+            "movl   %%eax, %%r8d\n\t"
+            "fadds  (%3)\n\t"
+            "fadds  4(%3)\n\t"
+            "fmuls  8(%3)\n\t"
+            "fstpl  (%4)\n\t"
+            "movl   %%r8d, %%eax\n\t"
+            "movl   %%eax, 8(%3)\n\t"
+            :
+            : "m"(out), "r"(a), "r"(src), "r"(dst), "r"(&out)
+            : "rax", "rcx", "rdx", "r8", "st", "cc", "memory");
+        check("ten-instruction gap: fp result", out, (a[0] * a[1] + 1.5 + 2.5) * -3.25);
+        check_u64("ten-instruction gap: integer result", dst[2],
+                  (uint32_t)(0x3fc0 + (int32_t)(int8_t)0xc0));
+        check_u64("ten-instruction gap: copies", ((uint64_t)dst[1] << 32) | dst[0],
+                  ((uint64_t)src[1] << 32) | src[0]);
+    }
+
+    printf("\n%s: %d failure(s)\n", failures ? "FAILED" : "OK", failures);
+    return failures ? 1 : 0;
+}
