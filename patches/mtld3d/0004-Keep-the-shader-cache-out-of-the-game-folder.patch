+
+/// MoBetta: directory under `%LOCALAPPDATA%` that holds the shader caches.
+const SHADER_CACHE_DIR: &str = "mtld3d-cache";
+
+/// MoBetta: the unix path of this executable's `mtld3d_shaders.bin`, or `None`.
+///
+/// Upstream keeps the cache beside the executable, which is the game's
+/// folder, and nothing of the engine may write there. It goes to
+/// `%LOCALAPPDATA%\mtld3d-cache\<exe stem>\` in the prefix instead, one
+/// directory per executable name, created here: a directory that does not
+/// exist yet may have no unix path. Without `%LOCALAPPDATA%` there is no
+/// cache; falling back to the executable's directory would write into the
+/// game's folder.
+fn shader_cache_location() -> Option<String> {
+    let exe = std::env::current_exe().ok()?;
+    let stem = exe.file_stem().map_or_else(
+        || String::from("mtld3d"),
+        |s| s.to_string_lossy().into_owned(),
+    );
+    let dir = crate::log_sink::local_app_data()?.join(SHADER_CACHE_DIR).join(stem);
+    std::fs::create_dir_all(&dir).ok()?;
+    crate::wine_path::unix_path(&dir.join("mtld3d_shaders.bin"))
+}
