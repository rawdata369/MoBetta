+
+/// `%LOCALAPPDATA%`, the parent of the default log directory, or `None`.
+///
+/// Wine sets it for every process from the prefix's user profile. Without
+/// it there is no default location and the log goes to stderr: falling back
+/// to the executable's directory would write into the game's folder.
+fn local_app_data() -> Option<PathBuf> {
+    std::env::var_os("LOCALAPPDATA")
+        .filter(|dir| !dir.is_empty())
+        .map(PathBuf::from)
 }
 
