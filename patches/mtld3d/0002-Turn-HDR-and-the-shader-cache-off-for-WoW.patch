@@ -72,6 +72,12 @@ fn the_wow_profile_matches_both_clients_and_keeps_the_immediate_answers() {
         assert!(profiled.query_event_immediate);
         // The resolution dropdown holds 32 buttons, one per size.
         assert_eq!(profiled.max_resolutions, 32);
+        // MoBetta: HDR and the in-game-folder shader cache off, and a user
+        // can still take either back.
+        assert!(stock.hdr_enable && stock.shader_cache_enable);
+        assert!(!profiled.hdr_enable);
+        assert!(!profiled.shader_cache_enable);
+        assert!(parse(Some(profile), "", Some("color.hdr.enable=true")).hdr_enable);
     }
     let nameless = AppIdentity::new("WoW.exe".to_owned(), None);
     assert!(lookup(&nameless).is_none());
